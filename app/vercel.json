{
  "crons": [
    {
      "path": "/api/cron/rebuild",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/rebuild",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/rebuild",
      "schedule": "30 13 * * *"
    }
  ],
  "functions": {
    "api/cron/rebuild.js": {
      "maxDuration": 300
    },
    "api/admin/rebuild.js": {
      "maxDuration": 300
    },
    "api/index.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "destination": "/api",
      "source": "/(.*)"
    }
  ]
}
